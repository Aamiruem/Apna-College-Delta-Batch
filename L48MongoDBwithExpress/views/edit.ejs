 <!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Your Chat</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            background: linear-gradient(to right, #89f7fe, #66a6ff);
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            margin: 0;
        }

        .edit-container {
            background: white;
            padding: 30px;
            width: 450px;
            border-radius: 15px;
            box-shadow: 0 8px 20px rgba(0,0,0,0.2);
        }

        h3 {
            text-align: center;
            color: #333;
            margin-bottom: 15px;
        }

        p {
            text-align: center;
            color: #555;
            font-size: 15px;
            margin-bottom: 20px;
        }

        textarea {
            width: 100%;
            height: 150px;
            padding: 12px;
            border: 1px solid #ccc;
            border-radius: 10px;
            resize: none;
            font-size: 15px;
            outline: none;
        }

        textarea:focus {
            border-color: #4facfe;
        }

        button {
            width: 100%;
            margin-top: 20px;
            padding: 12px;
            background: #4facfe;
            color: white;
            border: none;
            border-radius: 10px;
            font-size: 16px;
            cursor: pointer;
            transition: 0.3s;
        }

        button:hover {
            background: #007bff;
        }

        .chat-id {
            color: #007bff;
            font-size: 14px;
        }
    </style>
</head>
<body>

    <div class="edit-container">
        <h3>Edit Your Chat</h3>

        <p class="chat-id">Chat ID: <%= chat._id %></p>

        <p>
            This chat was sent from 
            <b><%= chat.from %></b> 
            to 
            <b><%= chat.to %></b>
        </p>

        <form method="POST" action="/chats/<%= chat._id %>?_method=PUT">
            <textarea name="msg"><%= chat.msg %></textarea>
            <button type="submit">Update Chat</button>
        </form>
    </div>

</body>
</html>
